# Configuración de Entorno (12-Factor) - PetMarket
# Copia este archivo a .env y modifica los valores según tu entorno

# Variables de entorno principales
ENVIRONMENT=development
PORT=8000

# Credenciales de base de datos
# Nota: Estos son valores por defecto para desarrollo local
POSTGRES_USER=petmarket_user
POSTGRES_PASSWORD=petmarket_pass
POSTGRES_DB=petmarket_db
TEST_POSTGRES_DB=petmarket_test

# URLs de conexión
# Puedes especificar URLs directamente o usar las variables de arriba
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${TEST_POSTGRES_DB}

# Supuestos de Negocio / Configuración inyectable (# SUPUESTO: validar con el negocio)
MAX_INTENTOS_ENTREGA=3
PLAZO_CANCELACION_DIAS=2
ESTRATEGIA_ASIGNACION_ALMACEN=MENOR_NUMERO_ALMACENES
