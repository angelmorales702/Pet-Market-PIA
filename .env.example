# Configuración de Entorno (12-Factor) - PetMarket
# Copia este archivo a .env y modifica los valores según tu entorno

# Variables de entorno principales
ENVIRONMENT=development
PORT=8000

# Credenciales de base de datos PostgreSQL
POSTGRES_USER=petmarket_user
POSTGRES_PASSWORD=petmarket_pass
POSTGRES_DB=petmarket_db
TEST_POSTGRES_DB=petmarket_test

# URLs de conexión a la base de datos
# Para localhost: usa localhost
# Para Docker: usa db como hostname
DATABASE_URL=postgresql://petmarket_user:petmarket_pass@localhost:5432/petmarket_db
TEST_DATABASE_URL=postgresql://petmarket_user:petmarket_pass@localhost:5432/petmarket_test

# Supuestos de Negocio / Configuración inyectable
MAX_INTENTOS_ENTREGA=3
PLAZO_CANCELACION_DIAS=2
ESTRATEGIA_ASIGNACION_ALMACEN=MENOR_NUMERO_ALMACENES

# Configuración de CI/CD
REQUIRE_DB=0
